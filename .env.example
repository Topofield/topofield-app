# Variables de entorno de TopoField — copiar a .env.local y rellenar.
# .env.local NO se versiona; este archivo (.env.example) sí.

# URL del API de Supabase. Para dev local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública (publishable / anon). Se expone al cliente. No es secreta.
# CLI v2+ la imprime como "Publishable" al ejecutar `npx supabase start`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta (secret / service_role). Solo server-side. NUNCA al cliente.
# CLI v2+ la imprime como "Secret" al ejecutar `npx supabase start`.
SUPABASE_SECRET_KEY=

# Código de invitación para poder registrarse. Secreta: NO lleva el prefijo
# NEXT_PUBLIC_, porque con él acabaría en el JavaScript que se envía al
# navegador y cualquiera podría leerlo.
#
# IMPORTANTE: si esta variable no está definida, el registro queda BLOQUEADO
# para todo el mundo. Es deliberado: un despliegue al que se le olvidó
# configurarla debe fallar de forma visible, no quedar con el registro abierto
# sin que nadie lo advierta.
SIGNUP_INVITE_CODE=
