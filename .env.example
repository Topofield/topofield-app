# Variables de entorno de TopoField — copiar a .env.local y rellenar.
# .env.local NO se versiona; este archivo (.env.example) sí.

# URL del API de Supabase. Para dev local: http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública (publishable / anon). Se expone al cliente. No es secreta.
# CLI v2+ la imprime como "Publishable" al ejecutar `npx supabase start`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta (secret / service_role). Solo server-side. NUNCA al cliente.
# CLI v2+ la imprime como "Secret" al ejecutar `npx supabase start`.
SUPABASE_SECRET_KEY=

# Aviso al administrador de cada solicitud de invitación (Fase 46). Secreta:
# la misma API key `re_…` de Resend que usa el SMTP de Supabase. Sin ella la
# solicitud se guarda igual, pero no llega el correo.
RESEND_API_KEY=

# A quién va ese aviso. Con el remitente de pruebas de Resend
# (onboarding@resend.dev) tiene que ser la dirección dueña de la cuenta de Resend.
ADMIN_EMAIL=
